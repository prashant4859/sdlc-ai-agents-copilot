{
  "name": "@sports-paradise/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "db:migrate": "node-pg-migrate up --migrations-dir migrations --envPath ../../.env --migration-file-language ts",
    "db:migration:create": "node-pg-migrate create --migrations-dir migrations --migration-file-language ts",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
